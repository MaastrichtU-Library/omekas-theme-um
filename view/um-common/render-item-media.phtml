<?php
// Shared partial: Render item/resource media.
// Determines the MIME-type of each item media and either renders it directly (for Audio/Video (AV), 3D and PDF types)
// or through the IIIF viewer configured in the theme settings (for all other types).
// Used by view/omeka/site/item/show.phtml and view/contribute/site/contribution/edit.phtml

/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $item The item (or resource) whose media should be rendered
 * @var string|null $rc CSS class derived from the resource class, added to the media-box(es) (optional)
 * @var string|null $mbc Additional CSS class for the media-embeds wrapper, e.g. "split" (optional)
 */

$rc = $rc ?? '';
$mbc = $mbc ?? '';

$itemMedia = $item->media();

// Array of 3D MIME-types supported by ModelViewer module
// For a complete list, see https://github.com/Daniel-KM/Omeka-S-module-ModelViewer#media-types-and-security-issue
$mediaTypes3D = [
    "application/octet-stream",
    "application/vnd.threejs+json",
    "model/gltf-binary",
    "model/gltf+json",
    "model/obj",
    "model/vnd.collada+xml",
    "model/vnd.filmbox",
    "image/ktx2",
    "model/mtl"
];

// Array of Audio and Video (AV) MIME-types
$mediaTypesAV = [
        "audio/midi",
        "audio/mp4",
        "audio/mpeg",
        "audio/ogg",
        "audio/x-aac",
        "audio/x-aiff",
        "audio/x-ms-wma",
        "audio/x-ms-wax",
        "audio/x-realaudio",
        "audio/x-wav",
        "video/divx",
        "video/mp4",
        "video/mpeg",
        "video/ogg",
        "video/quicktime",
        "video/webm",
        "video/x-ms-asf",
        "video/x-msvideo",
        "video/x-ms-wmv"
];

// Array of PDF MIME-types
$mediaTypesPDF = ['application/pdf'];

// Concatenate all non-IIIF media types into a single array
$nonIiifMediaTypes = array_merge($mediaTypes3D, $mediaTypesAV, $mediaTypesPDF);

// Determine if any media requires direct rendering without IIIF viewer (this is true for AV, 3D, or PDF)
$renderWithIiif = true;
foreach ($itemMedia as $media) {
    if (in_array($media->mediaType(), $nonIiifMediaTypes)) {
        $renderWithIiif = false;
        break;
    }
}
?>
<?php if (!$renderWithIiif): ?>
    <div class="media-embeds <?php echo trim($rc . " " . $mbc); ?>">
        <?php foreach ($itemMedia as $media): ?>
            <?php if (in_array($media->mediaType(), $nonIiifMediaTypes)): ?>
                <div class="media-box <?php echo $rc; ?>">
                    <div class="media-box-content">
                        <?php echo $media->render(); ?>
                    </div>
                </div>
            <?php endif; ?>
        <?php endforeach; ?>
    </div>

<?php else: ?>
    <!-- Use an IIIF viewer in all other cases -->
    <div class="media-embeds">
        <div class="media-box <?php echo $rc; ?>">
            <div class="media-box-content">
                <?php
                    if ($this->themeSetting('IiifViewer') == "universal") {
                        echo $this->universalViewer($item);
                    } elseif ($this->themeSetting('IiifViewer') == "mirador") {
                        echo $this->mirador($item);
                    } else {
                        foreach ($itemMedia as $media) {
                            echo $media->render();
                        }
                    }
                ?>
            </div>
        </div>
    </div>
<?php endif; ?>
